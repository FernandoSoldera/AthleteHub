# Copy to .env and fill in. The app loads this via spring.config.import (spring-dotenv).
# .env is gitignored — never commit real secrets.

# Server
SERVER_PORT=8080

# Database (matches docker-compose.yml defaults)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=athletehub
DB_USER=athletehub_user
DB_PASSWORD=athletehub_password

# JWT (generate a long random secret for non-dev; >= 64 chars for HS512)
JWT_SECRET=change-me-to-a-long-random-secret-at-least-64-characters-long-please-xx
JWT_ACCESS_TOKEN_EXPIRATION_MS=900000
JWT_REFRESH_TOKEN_EXPIRATION_DAYS=30

# Email / SMTP (EPIC 1: activation + password reset)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# CORS (comma-separated app origins; leave empty for native-only)
CORS_ALLOWED_ORIGINS=

# Logging / misc
JPA_SHOW_SQL=false
LOG_LEVEL_APP=INFO
ACTUATOR_ENDPOINTS=health
