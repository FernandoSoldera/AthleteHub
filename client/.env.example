# Copy to .env. The app loads this via flutter_dotenv at startup.
# .env is gitignored — never commit it.

# Backend base URL (used by services/api/* clients)
# Use 10.0.2.2 for Android emulator → host loopback.
# Use 127.0.0.1 / your-LAN-IP for iOS simulator / physical devices.
API_BASE_URL=http://10.0.2.2:8080
